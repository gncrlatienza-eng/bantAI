    <!--
      In-app logo mark. Same shape as ic_launcher_foreground, but cropped
      tightly to the artwork's own bounds (that file's 512x512 viewport is
      mostly empty safe-zone padding for the adaptive-icon mask to crop into —
      fine for a launcher icon, but a plain Image() has no mask, so the same
      coordinates would render the mark tiny inside a mostly-blank box) —
      keep in sync with ic_launcher_foreground / ic_launcher_monochrome.
    -->

    <!-- Chat bubble: rounded body with a tail at bottom-left -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M112,0 C49,0 0,39 0,87 C0,122 25,153 62,167 C59,179 52,190 43,199 C41,201 42,204 45,204 C67,203 87,195 103,184 C106,184 109,184 112,184 C175,184 224,145 224,87 C224,39 175,0 112,0 Z" />

    <!-- Small shield, sitting inside the bubble -->
    <path
        android:fillColor="#4338CA"
        android:pathData="M112,46 L138,57 L138,79 C138,101 127,116 112,123 C97,116 86,101 86,79 L86,57 Z" />

</vector>
