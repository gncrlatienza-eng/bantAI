# BantAI ML service configuration (copy to ai/.env). Prefix: BANTAI_AI_
BANTAI_AI_MODEL_DIR=models/xlm-roberta-smishing
# External operator approval manifest with the approved version and SHA-256
# for every model artifact. Leave empty to keep inference fail-closed.
BANTAI_AI_MODEL_APPROVAL_PATH=
BANTAI_AI_MAX_LENGTH=128

# Confidence-threshold routing (Sprint 2). Model predicts Ham/Spam/Scam; these
# per-class thresholds decide the user bucket (below its bar -> Unknown/inbox):
#   Ham  >= SAFE_THRESHOLD  -> safe    (inbox)
#   Spam >= SPAM_THRESHOLD  -> spam    (dropdown)
#   Scam >= BLOCK_THRESHOLD -> blocked (dropdown)
BANTAI_AI_SAFE_THRESHOLD=0.50
BANTAI_AI_SPAM_THRESHOLD=0.60
BANTAI_AI_BLOCK_THRESHOLD=0.90

# Campaign clustering (Sprint 3). Where the live matcher gets centroids from:
#   backend (default) -- GET /campaigns/centroids on the NestJS service
#   file               -- no-backend/no-database local-dev fallback
#   none               -- disable campaign matching entirely
BANTAI_AI_CENTROID_SOURCE=backend
BANTAI_AI_BACKEND_URL=http://localhost:3000/api

# Scoped credentials for backend capabilities and backend -> AI calls.
BANTAI_AI_CAMPAIGNS_API_KEY=
BANTAI_AI_MODELS_API_KEY=
BANTAI_AI_SERVICE_API_KEY=

# The service key is required outside explicit local development: without it
# (or with one shorter than 32 characters outside local/test) the
# service refuses to start, and gated routes answer 503. Only local
# and test may opt out when intentionally bound to a trusted local
# interface. /docs and /openapi.json are served only in those environments.
BANTAI_AI_ENVIRONMENT=development
BANTAI_AI_ALLOW_UNAUTHENTICATED_DEV=false
BANTAI_AI_MAX_REQUEST_BODY_BYTES=393216
BANTAI_AI_MAX_CONCURRENT_OPERATIONS=4

# Retraining round trip (Sprint 4, WBS 4.4.3). POST /retrain records the
# backend cron's trigger requests (this service has no GPU, so it queues
# rather than trains); GET /retrain/jobs reads the queue back, and
# POST /retrain/jobs/{id}/complete marks one drained (as does
# `scripts/retrain.py --complete-queue` after a real run). At most 50 jobs may
# be outstanding; past that POST /retrain answers 503 rather than growing the
# file forever.
BANTAI_AI_RETRAIN_QUEUE_PATH=models/retrain_queue/queue.jsonl

# At startup, compare the checkpoint this service is serving against the
# backend's active ModelVersion and log loudly on a mismatch (non-fatal --
# see service/main.py:check_served_version). Set to false to skip the check
# entirely, e.g. running the service with no backend up at all.
BANTAI_AI_VERSION_CHECK_ENABLED=true

# --- Routing and campaign matching -------------------------------------------
# How far the top class must lead the runner-up before the verdict is acted on;
# below this the message is routed to "unknown" no matter what the per-class
# thresholds say (service/classifier.py:route). Manuscript Stage 7 deviation --
# see docs/api/classify.md.
BANTAI_AI_REVIEW_MARGIN=0.15

# Cosine similarity a message must reach against a campaign centroid to be
# attached to it. 0.85 in the manuscript; re-calibrated to 0.999 and then to
# 0.998 for the 2026-08-27 checkpoint, back to 0.999 for Model C (2026-09-27).
# Re-calibrate after any promotion: the
# embedding space moves, and the working margin here is ~0.0008 wide
# (service/campaign.py).
BANTAI_AI_CAMPAIGN_THRESHOLD=0.999

# Item 19: the space scam campaigns are clustered and matched in, with the
# thresholds calibrated in it (scripts/calibrate_campaign_space.py). Only used
# when the loaded centroids say they are in a space ("@space:<id>" in their
# label); for those, it replaces BANTAI_AI_CAMPAIGN_THRESHOLD above. Tied to
# one model version -- the service refuses to match if they disagree.
# In shared development and production this must be inside MODEL_DIR so the
# external approval manifest pins its SHA-256 with the rest of the bundle.
BANTAI_AI_CAMPAIGN_SPACE_FILE=models/xlm-roberta-smishing/campaign_space.json

# Offline clustering output, used only when BANTAI_AI_CENTROID_SOURCE=file.
BANTAI_AI_CLUSTER_FILE=datasets/processed/campaign_clusters.json
