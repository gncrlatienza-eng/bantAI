# Copy to web/.env.production (or set in the hosting provider's build
# settings) before `npm run build`. Read at build time and baked into the
# bundle, so never put a secret here.

# The deployed backend, including the /api prefix. HTTPS only: a production
# build fails without it (vite.config.ts) rather than silently calling
# http://localhost:3000/api from every visitor's browser.
# Use /api only when the hosting server proxies that path to the backend.
VITE_API_URL=https://api.example.com/api
