<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    <!-- Debug-only: plain HTTP to the backend on the development machine.
         localhost = USB device via `adb reverse`; 10.0.2.2 = emulator host alias.
         This file overrides res/main's stricter version for debug builds only
         (Gradle resource merging picks src/debug over src/main) — a release
         build never has any cleartext exception, closing the gap where a
         malicious co-resident app could bind localhost:3000 and intercept
         plaintext OTP/JWT traffic. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
