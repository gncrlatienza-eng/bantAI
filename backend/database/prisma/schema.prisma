generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())

  phone     String   @unique
  email     String?  @unique
  role      UserRole @default(USER)

  firstName String?
  lastName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages       SmsMessage[]
  contacts       Contact[]
  blockedNumbers BlockedNumber[]
  reports        UserReport[]
  senderReports  SenderReport[]
  moderatedSenderReports SenderReport[] @relation("SenderReportReviewer")
  organizationMemberships OrganizationMembership[]
}

enum UserRole {
  USER
  ADMIN
}

// Dashboard tenancy is intentionally separate from the global ADMIN role.
// A member can be permitted to inspect only their organization's masked data.
enum OrganizationMemberRole {
  TIER_1
  TIER_2
}

model PortalOrganization {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members OrganizationMembership[]
}

model OrganizationMembership {
  id             String                 @id @default(uuid())
  organizationId String
  organization   PortalOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationMemberRole
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, role])
}

// Synced from the user's Android phone contacts.
// Stage 1 of sender verification — checked before any external API call.
model Contact {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  // HMAC fingerprint of a canonical phone number; raw contacts and names are
  // never retained.
  phone     String
  name      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, phone])
}

model OtpCode {
  id         String   @id @default(uuid())

  phone      String   @unique
  codeHash   String

  expiresAt  DateTime
  verified   Boolean  @default(false)
  attempts   Int      @default(0)
  requestCount Int    @default(0)
  requestWindowStart DateTime @default(now())

  createdAt  DateTime @default(now())

  @@index([phone, verified, createdAt])
}

model SmsMessage {
  id         String   @id @default(uuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id])

  clusterId  String?
  cluster    CampaignCluster? @relation(fields: [clusterId], references: [id])

  sender     String
  // Privacy-masked text only. The original SMS body is never persisted.
  body       String
  sourceId   String?
  // Mobile-submitted telemetry is intentionally non-authoritative. It is not
  // included in global metrics, campaigns, or retraining without review.
  trusted    Boolean  @default(false)
  receivedAt DateTime @default(now())

  classification Classification?
  feature        MessageFeature?
  alerts         Alert[]
  reports        UserReport[]

  @@index([userId, receivedAt])
  @@unique([userId, sourceId])
  @@index([clusterId, receivedAt])
}

model MessageFeature {
  id             String   @id @default(uuid())

  messageId      String   @unique
  message        SmsMessage @relation(fields: [messageId], references: [id])

  normalizedBody String
  maskedBody     String
  suppressedLinks String[] // URLs hidden because message was flagged or sender unknown

  createdAt      DateTime @default(now())
}

model Classification {
  id        String   @id @default(uuid())

  messageId String   @unique
  message   SmsMessage @relation(fields: [messageId], references: [id])

  label     String   // Scam | Spam | Ham
  score     Float
  scores    Json?    // full softmax distribution: { Ham, Spam, Scam }
  bucket    String?  // AI routing decision: safe | unknown | spam | blocked

  createdAt DateTime @default(now())

  indicator ExplainableIndicator?

  @@index([createdAt])
}

model Alert {
  id        String   @id @default(uuid())

  messageId String
  message   SmsMessage @relation(fields: [messageId], references: [id])

  status    String   @default("Pending") // Pending | Blocked | Reported | Ignored

  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([status])
}

// Groups of similar smishing messages detected by AI clustering (HDBSCAN).
// Created and updated by the AI/ML service; the backend links new messages
// to an existing cluster when URL domains match.
model CampaignCluster {
  id           String   @id @default(uuid())

  label        String?  // human-readable campaign label set by AI/ML
  centroid     Json?    // embedding vector used for cosine similarity (set by AI/ML)
  urlDomains   String[] // known URL domains in this campaign (for link suppression)
  isActive     Boolean  @default(true)
  messageCount Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages     SmsMessage[]

  @@index([isActive])
  @@index([urlDomains], type: Gin)
}

// SHAP-based feature importance for a single classification result.
// Populated by the AI/ML service after SHAP analysis; the backend
// exposes the endpoint, the AI/ML track fills it in.
model ExplainableIndicator {
  id               String         @id @default(uuid())

  classificationId String         @unique
  classification   Classification @relation(fields: [classificationId], references: [id])

  indicators       Json           // [{ tag: string, weight: number }]

  createdAt        DateTime       @default(now())
}

// Senders blocked by the user or auto-blocked by the system (score ≥ 0.90).
// Checked at the start of every ingest — blocked messages are suppressed
// before classification runs.
model BlockedNumber {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  // HMAC fingerprint; the raw phone number/sender value is not retained.
  sender    String
  source    String           // AutoBlock | UserBlock
  createdAt DateTime @default(now())

  @@unique([userId, sender])
}

// Caches sender verification results (verified | fraud | unknown) so we
// don't re-check the same sender repeatedly.
model SenderVerificationCache {
  id        String    @id @default(uuid())

  sender    String    @unique // phone number or sender name
  status    String            // verified | fraud | unknown
  source    String?           // how it was determined

  expiresAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Curated sender identity evidence. This is deliberately not a crowd-sourced
// "known caller" graph: organization records may be created only after a
// reviewer verifies an official source (for example, a government registry or
// an organization-controlled domain). The sender remains HMAC-pseudonymized.
model TrustedOrganization {
  id              String   @id @default(uuid())
  name            String
  sender          String   @unique
  officialDomains String[]
  evidenceUrl     String
  evidenceType    String
  reviewedBy      String
  expiresAt       DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, expiresAt])
  @@index([officialDomains], type: Gin)
}

// Attribution for community sender reports. A sender is not globally marked as
// fraud until several distinct authenticated users have corroborated it.
model SenderReport {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender    String
  reportWindow String
  status    String   @default("Pending")
  validatedAt DateTime?
  reviewedBy String?
  reviewer User? @relation("SenderReportReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewReason String?
  createdAt DateTime @default(now())

  @@unique([userId, sender, reportWindow])
  @@index([sender, status, createdAt])
}

// User-submitted FP/FN corrections used to feed the retraining pipeline.
// State machine: Pending → Validated (queued for retrain) | Rejected (discarded)
// Validated reports accumulate until a trigger threshold (50) fires retraining.
model UserReport {
  id            String     @id @default(uuid())

  userId        String
  user          User       @relation(fields: [userId], references: [id])

  messageId     String
  message       SmsMessage @relation(fields: [messageId], references: [id])

  originalLabel String     // AI label at receive time: Ham | Spam | Scam
  reportedLabel String     // what user says it should be: Ham | Spam | Scam

  // Pending → Validated (accepted into training set) | Rejected (discarded)
  status        String     @default("Pending")
  adminNote     String?
  validatedAt   DateTime?  // set when status transitions to Validated; used by AI retraining pipeline

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([userId, messageId]) // one report per user per message
  @@index([status, validatedAt])
}

// Tracks every model version that was ever promoted to production.
// Used for promotion gating (McNemar + F1 floor) and rollback.
model ModelVersion {
  id           String    @id @default(uuid())

  versionTag   String    @unique // e.g. "v1.0.0", auto-generated by AI service
  f1Score      Float               // macro-F1 at promotion time (0–1)
  accuracy     Float?

  isActive     Boolean   @default(false) // only one version is active at a time
  isRollback   Boolean   @default(false) // true when restored via rollback

  notes        String?
  promotedAt   DateTime  @default(now())
  rolledBackAt DateTime?

  createdAt    DateTime  @default(now())

  @@index([isActive])
}
