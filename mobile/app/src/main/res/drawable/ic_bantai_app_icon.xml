<?xml version="1.0" encoding="utf-8"?>
<!-- The BantAI app icon as one image: the indigo gradient tile
     (ic_launcher_background's #6366F1 to #4338CA, top-left to bottom-right)
     with the white bubble and indigo shield (ic_bantai_logo) at the home-screen
     icon's proportions. Tile 80x80 with 18 corners (22.5%); the mark is 65% of
     the tile's width (52 wide, 224:204 aspect) and centred.

     It is the single source for every in-app logo (BantAILogo.kt) and for the
     launch window (launch_background.xml), so the logo is drawn identically
     everywhere; two separately-sized copies used to make it visibly jump from
     small to big on start-up. Keep the mark paths in sync with ic_bantai_logo. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="80dp"
    android:height="80dp"
    android:viewportWidth="80"
    android:viewportHeight="80">

    <path android:pathData="M18,0 L62,0 A18,18 0 0,1 80,18 L80,62 A18,18 0 0,1 62,80 L18,80 A18,18 0 0,1 0,62 L0,18 A18,18 0 0,1 18,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="80"
                android:endY="80"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="@color/logo_gradient_start" android:offset="0" />
                <item android:color="@color/logo_gradient_end" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The mark: ic_bantai_logo's 224x204 artwork scaled to 52 wide
         (52/224 = 0.232143) and centred: x (80-52)/2 = 14, y (80-47.36)/2 = 16.32. -->
    <group
        android:scaleX="0.232143"
        android:scaleY="0.232143"
        android:translateX="14"
        android:translateY="16.32">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M112,0 C49,0 0,39 0,87 C0,122 25,153 62,167 C59,179 52,190 43,199 C41,201 42,204 45,204 C67,203 87,195 103,184 C106,184 109,184 112,184 C175,184 224,145 224,87 C224,39 175,0 112,0 Z" />
        <path
            android:fillColor="#4338CA"
            android:pathData="M112,46 L138,57 L138,79 C138,101 127,116 112,123 C97,116 86,101 86,79 L86,57 Z" />
    </group>
</vector>
