{
  "name": "bantai-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:public": "tsc -b && vite build --mode public",
    "build:client": "tsc -b && vite build --mode client",
    "build:admin": "tsc -b && vite build --mode admin",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "landing:shoot": "node ../tools/landing-capture/shoot-landing.mjs",
    "landing:audit": "node ../tools/landing-capture/audit-landing.mjs",
    "landing:verify-assets": "node ../tools/landing-capture/verify-assets.mjs src/assets/landing/captures",
    "landing:capture": "node ../tools/landing-capture/capture-portal.mjs",
    "landing:encode": "node ../tools/landing-capture/encode.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "lucide-react": "^1.67.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
