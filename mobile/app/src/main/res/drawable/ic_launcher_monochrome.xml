<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!--
      Themed-icon (Android 13+) layer. Foreground only — the system supplies its
      own background fill and tints this single colour, so the shield cannot be
      drawn in a second colour. Both subpaths live in one path with evenOdd fill
      so the shield reads as a hole punched through the bubble.
      Keep in sync with ic_launcher_foreground.

      Viewport/coordinates deliberately kept at the launcher's original 512
      safe-zone-padded space here (unlike ic_bantai_logo, which is cropped
      tight) — the OS applies its own adaptive-icon mask to this layer, which
      relies on that padding to avoid clipping the mark. Anyone reusing this
      drawable directly as a plain in-app icon (no mask involved, e.g. via
      ImageVector.vectorResource) should expect it to render small within its
      bounding box for the same reason — size the container generously rather
      than assuming edge-to-edge fill.
    -->

    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M256,156 C193,156 144,195 144,243 C144,278 169,309 206,323 C203,335 196,346 187,355 C185,357 186,360 189,360 C211,359 231,351 247,340 C250,340 253,340 256,340 C319,340 368,301 368,243 C368,195 319,156 256,156 Z M256,202 L282,213 L282,235 C282,257 271,272 256,279 C241,272 230,257 230,235 L230,213 Z" />

