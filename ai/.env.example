# BantAI ML service configuration (copy to ai/.env). Prefix: BANTAI_AI_
BANTAI_AI_MODEL_DIR=models/xlm-roberta-smishing
BANTAI_AI_MAX_LENGTH=128

# Confidence-threshold routing (Sprint 2). Model predicts Ham/Spam/Scam; these
# per-class thresholds decide the user bucket (below its bar -> Unknown/inbox):
#   Ham  >= SAFE_THRESHOLD  -> safe    (inbox)
#   Spam >= SPAM_THRESHOLD  -> spam    (dropdown)
#   Scam >= BLOCK_THRESHOLD -> blocked (dropdown)
BANTAI_AI_SAFE_THRESHOLD=0.50
BANTAI_AI_SPAM_THRESHOLD=0.60
BANTAI_AI_BLOCK_THRESHOLD=0.90

# Campaign clustering (Sprint 3). Where the live matcher gets centroids from:
#   backend (default) -- GET /campaigns/centroids on the NestJS service
#   file               -- no-backend/no-database local-dev fallback
#   none               -- disable campaign matching entirely
BANTAI_AI_CENTROID_SOURCE=backend
BANTAI_AI_BACKEND_URL=http://localhost:3000/api

# Shared secret for the backend's internal (ApiKeyGuard) routes -- sent as the
# `x-api-key` header. Must match INTERNAL_API_KEY in backend/.env exactly.
# Used by two callers:
#   GET /campaigns/centroids  -- this service, at startup
#   GET /reports              -- scripts/retrain.py, via DatabaseReportSource
# Leave it unset and both routes answer 401. Centroid loading degrades quietly
# to "0 campaigns" (matching is an enhancement); the report source raises,
# because retraining on silently-zero corrections is the failure it exists to
# prevent.
BANTAI_AI_BACKEND_API_KEY=
