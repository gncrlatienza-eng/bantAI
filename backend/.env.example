DATABASE_URL=postgresql://bantai:bantai_dev@localhost:5434/bantai_db
SHADOW_DATABASE_URL=postgresql://bantai:bantai_dev@localhost:5434/bantai_shadow
JWT_SECRET=change-me-use-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_ISSUER=bantai-api
# Web sessions use unrelated high-entropy values. JWT_SECRET remains the
# existing mobile/Semaphore signing key so the mobile contract is unchanged.
CLIENT_JWT_SECRET=change-me-client-jwt-secret
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
PORT=3000
# Comma-separated browser origins. Required in production; do not use a wildcard.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
# Production defaults to disabled. Enable only behind an authenticated internal gateway.
API_DOCS_ENABLED=false
OTP_HASH_SECRET=change-me-use-a-separate-long-random-string
EMAIL_OTP_HASH_SECRET=change-me-use-another-separate-long-random-string
SENDER_HASH_SECRET=change-me-use-a-separate-long-random-string
# Optional external phone-reputation lookup. The key stays server-side; the
# adapter sends only a canonical sender number, never SMS content or user IDs.
IPQS_API_KEY=
AI_SERVICE_URL=http://localhost:8001
# Shared secret forwarded as `x-api-key` on backend->AI classify/summarize
# calls. Must match BANTAI_AI_SERVICE_API_KEY on the AI service. Empty in
# local development where the AI service also runs with no key.
AI_SERVICE_API_KEY=
AI_CAMPAIGNS_API_KEY=change-me-campaign-sync-secret
AI_MODELS_API_KEY=change-me-model-registry-secret
AI_INDICATORS_API_KEY=change-me-indicator-write-secret
# Lets the training pipeline read frozen dataset snapshots (GET /api/internal/datasets/snapshots/:versionTag).
AI_DATASETS_API_KEY=change-me-dataset-snapshot-secret
# Set only when the backend is behind exactly this many trusted proxies.
TRUST_PROXY_HOPS=0
# Temporary mobile OTP delivery switch while Semaphore approval is pending.
# Use "email" for the dedicated Gmail endpoints; change back to "sms" after
# approval. Both paths stay isolated and fail closed when unconfigured.
MOBILE_OTP_DELIVERY=email
# Semaphore PH SMS gateway — get API key at https://semaphore.co
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=BANTAIPH

# Web portal and temporary mobile OTP via a dedicated Gmail/Workspace mailbox.
# Enable 2-Step Verification and use an App Password; never use the mailbox's
# normal password or expose these values to Vite/browser configuration.
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
PORTAL_FROM_EMAIL=
# Temporary rollback switch for the existing email/password portal. Leave
# false in production after the frontend adopts the email-OTP endpoints.
ENABLE_LEGACY_PORTAL_PASSWORD_AUTH=false

# Licensing / Stripe
# Frontend origin the backend redirects into after Stripe Checkout completes.
FRONTEND_URL=http://localhost:5173
# Local development uses Stripe's test environment and creates inline test
# prices, so dashboard Price IDs are not required. Production must use live.
STRIPE_CHECKOUT_MODE=test
# Stripe secret key (server-side only; never expose to the browser).
# Use an sk_test_ key for test mode and an sk_live_ key for live mode.
STRIPE_SECRET_KEY=
# Webhook signing secret from `stripe listen` (dev) or the dashboard (prod).
# The webhook endpoint refuses to boot without this, so unsigned events can
# never activate a license.
STRIPE_WEBHOOK_SECRET=
# Live-mode recurring Stripe Price IDs. Test mode uses the same amounts as
# inline test prices and does not require these IDs.
STRIPE_PRICE_RESEARCH_ANNUAL=
STRIPE_PRICE_RESEARCH_MONTHLY=
STRIPE_PRICE_ORGANIZATION_ANNUAL=
STRIPE_PRICE_ORGANIZATION_MONTHLY=

# Portal license entitlement policy. These values are enforced server-side.
# Research data is delayed by default; Organization receives current data.
RESEARCH_DATA_DELAY_MINUTES=1440
RESEARCH_MAXIMUM_MEMBERS=3
RESEARCH_MAXIMUM_EXPORT_ROWS=5000
ORGANIZATION_MAXIMUM_MEMBERS=100
ORGANIZATION_MAXIMUM_EXPORT_ROWS=100000
# Organization API access remains deny-by-default until the API is released.
# Research API access remains denied regardless of this flag.
PORTAL_API_RELEASED=false

# Model lifecycle and campaign analysis
# The hourly retraining check only sends requests when this is "true".
# When "true", AI_DATASETS_API_KEY is required at startup: queued jobs name a
# frozen dataset snapshot that the offline trainer downloads with that key.
RETRAINING_ENABLED=false
# Daily 00:15 UTC campaign window analysis; set to "false" to disable the cron.
# Admins can still run it from a campaign's detail page.
CAMPAIGN_ANALYSIS_ENABLED=true
