DATABASE_URL=postgresql://bantai:bantai_dev@localhost:5434/bantai_db
SHADOW_DATABASE_URL=postgresql://bantai:bantai_dev@localhost:5434/bantai_shadow
JWT_SECRET=change-me-use-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=3000
# Comma-separated browser origins. Required in production; do not use a wildcard.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
# Production defaults to disabled. Enable only behind an authenticated internal gateway.
API_DOCS_ENABLED=false
OTP_HASH_SECRET=change-me-use-a-separate-long-random-string
SENDER_HASH_SECRET=change-me-use-a-separate-long-random-string
# Optional external phone-reputation lookup. The key stays server-side; the
# adapter sends only a canonical sender number, never SMS content or user IDs.
IPQS_API_KEY=
AI_SERVICE_URL=http://localhost:8001
# Shared secret forwarded as `x-api-key` on backend->AI classify/summarize
# calls. Must match BANTAI_AI_SERVICE_API_KEY on the AI service. Empty in
# local development where the AI service also runs with no key.
AI_SERVICE_API_KEY=
AI_CAMPAIGNS_API_KEY=change-me-campaign-sync-secret
AI_MODELS_API_KEY=change-me-model-registry-secret
AI_INDICATORS_API_KEY=change-me-indicator-write-secret
# Set only when the backend is behind exactly this many trusted proxies.
TRUST_PROXY_HOPS=0
# Semaphore PH SMS gateway — get API key at https://semaphore.co
# Required in every environment that performs OTP authentication. OTPs are
# never logged, and requests fail closed when a delivery provider is absent.
SEMAPHORE_API_KEY=

# Licensing / Stripe
# Frontend origin the backend redirects into after Stripe Checkout completes.
FRONTEND_URL=http://localhost:5173
# Stripe secret key (server-side only; never expose to the browser).
STRIPE_SECRET_KEY=
# Webhook signing secret from `stripe listen` (dev) or the dashboard (prod).
# The webhook endpoint refuses to boot without this, so unsigned events can
# never activate a license.
STRIPE_WEBHOOK_SECRET=
# Recurring Stripe Price IDs the checkout session references. Create these
# in the Stripe dashboard (or with the CLI) at ₱24,900/yr, ₱2,490/mo,
# ₱299,000/yr, and ₱29,900/mo respectively.
STRIPE_PRICE_RESEARCH_ANNUAL=
STRIPE_PRICE_RESEARCH_MONTHLY=
STRIPE_PRICE_ORGANIZATION_ANNUAL=
STRIPE_PRICE_ORGANIZATION_MONTHLY=
